<app-panel-navbar></app-panel-navbar>

<div class="container mt-5 mb-5 p-4 my-3">
  <div class="row mt-">
    <!-- Columna izquierda: Formulario -->
    <div class="mt-5 col-lg-4 col-md-12">
      <h2>Formulario de usuarios</h2>
      <form id="userForm" onsubmit="addUser(event)">
        <div class="mb-3">
          <label for="usuario" class="form-label">Usuario</label>
          <input type="text" class="form-control" id="usuario" placeholder="Ingresa un usuario..." required maxlength="15">
          <div class="invalid-feedback">Por favor, ingresa un nombre de usuario válido (máximo 15 caracteres).</div>
        </div>
        <div class="mb-3">
          <label for="correo" class="form-label">Correo</label>
          <input type="email" class="form-control" id="correo" placeholder="Ingresa un correo..." required maxlength="20">
          <div class="invalid-feedback">Por favor, ingresa una dirección de correo electrónico válida.</div>
        </div>
        <div class="mb-3">
          <label for="contraseña" class="form-label">Contraseña</label>
          <input type="password" class="form-control" id="contraseña" placeholder="Ingresa una contraseña..." required minlength="6" maxlength="30">
          <div class="invalid-feedback">La contraseña debe tener al menos 6 caracteres y un máximo de 30 caracteres.</div>
        </div>
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-success">Guardar</button>
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('userForm').reset()">Limpiar</button>
        </div>
      </form>

    </div>

    <!-- Columna derecha: Tabla de usuarios -->
    <div class="mt-5 col-lg-8 col-md-12">
      <app-user-table [users]="users"></app-user-table>
    </div>
  </div>

  <!-- Sección donde se incluye el componente de menú (fuera del formulario) -->
  <div class="mt-3">
    <app-menu></app-menu>
  </div>
</div>

<app-footer></app-footer>
